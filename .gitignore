# Python bytecode & cache
__pycache__/
*.py[cod]
*.class

# Temporary outputs & runtime artifacts
output/*
output/**/*
!output/.gitkeep

# Node.js dependencies
frontend/node_modules/
frontend/.npm/
frontend/.vite/

# Environments
.env
.env.local
.venv/
venv/
ENV/
env/

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# User-maintained factory and supplier records (never commit client data)
factory_settings.json
supplier_catalog.json
factory_settings.tmp
supplier_catalog.tmp

# Logs & sqlite
*.log
*.sqlite3

# Encrypted recovery archives and TLS private key material (never commit)
*.ahb
*.key
*.pem
*.p12
*.pfx
